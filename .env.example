# Database Configuration - local Docker/PostgreSQL
POSTGRES_DB=boane_conecta
POSTGRES_USER=boane_user
POSTGRES_PASSWORD=boane_password_dev
DATABASE_URL=jdbc:postgresql://localhost:5432/boane_conecta
DATABASE_USERNAME=boane_user
DATABASE_PASSWORD=boane_password_dev

# Railway/PostgreSQL production alternatives
# Prefer Railway-provided PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD.
# Or set JDBC_DATABASE_URL, JDBC_DATABASE_USERNAME, JDBC_DATABASE_PASSWORD manually.
SPRING_PROFILES_ACTIVE=prod
JDBC_DATABASE_URL=jdbc:postgresql://host:5432/database
JDBC_DATABASE_USERNAME=postgres
JDBC_DATABASE_PASSWORD=change-me

# JWT Configuration
JWT_SECRET=replace-with-a-strong-secret-at-least-256-bits-long-enough-for-hs256
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Bootstrap Admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-initial-admin-password

# Application Configuration
STORAGE_ROOT=./storage/uploads
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8080
PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75
